    "responsive",
    "multi-user",
    "personas",
    "devtools",
    "sessions",
    "screenshots"
  ],
  "homepage": "https://github.com/akbarsha03/nstack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akbarsha03/nstack.git"
  },
  "bugs": "https://github.com/akbarsha03/nstack/issues",
